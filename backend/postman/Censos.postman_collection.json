{
  "info": {
    "name": "Censos y roles - Desarrollo Móvil",
    "description": "Registrar las cuentas, asignar ADMINISTRADOR en MySQL a la segunda cuenta, ejecutar los logins y probar las solicitudes. No asigna privilegios desde el registro público.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "censistUser",
      "value": "censista.prueba@example.com"
    },
    {
      "key": "adminUser",
      "value": "admin.prueba@example.com"
    },
    {
      "key": "password",
      "value": "Prueba123!"
    },
    {
      "key": "censistToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "cursor",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "1. Registrar censista",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Usuario\",\n  \"lastName\": \"Prueba\",\n  \"username\": \"{{censistUser}}\",\n  \"email\": \"{{censistUser}}\",\n  \"password\": \"{{password}}\",\n  \"gender\": \"Otro\",\n  \"birthDate\": \"2000-01-10\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "2. Registrar cuenta para administrador (asignar rol en BD después)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Usuario\",\n  \"lastName\": \"Prueba\",\n  \"username\": \"{{adminUser}}\",\n  \"email\": \"{{adminUser}}\",\n  \"password\": \"{{password}}\",\n  \"gender\": \"Otro\",\n  \"birthDate\": \"2000-01-10\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "3. Login censista",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login correcto\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"censistToken\", pm.response.json().body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{censistUser}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "4. Login administrador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login correcto\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"adminToken\", pm.response.json().body.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{adminUser}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "5. Capturar censo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Censo creado\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.test(\"Origen normal\", () => pm.expect(pm.response.json().body.origin).to.eql(\"NORMAL\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{censistToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ana\",\n  \"lastName\": \"López\",\n  \"totalMembers\": 4,\n  \"televisionCount\": 2,\n  \"latitude\": 14.6349,\n  \"longitude\": -90.5069\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/censuses"
      }
    },
    {
      "name": "6. Consultar todos los censos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/censuses?afterId={{cursor}}&limit=500"
      }
    },
    {
      "name": "7. Consultar censos masivos",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/censuses?origin=MASIVO&afterId=0&limit=500"
      }
    },
    {
      "name": "8. Consultar perfil censista",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{censistToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/profile"
      }
    },
    {
      "name": "9. Consultar perfil administrador",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/profile"
      }
    },
    {
      "name": "10. Censista no puede consultar censos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Acceso rechazado\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{censistToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/censuses"
      }
    },
    {
      "name": "11. Administrador no puede capturar",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Acceso rechazado\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ana\",\n  \"lastName\": \"López\",\n  \"totalMembers\": 4,\n  \"televisionCount\": 2,\n  \"latitude\": 14.6349,\n  \"longitude\": -90.5069\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/censuses"
      }
    }
  ]
}
